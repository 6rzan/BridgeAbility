option_settings:
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /health

  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production

  aws:ec2:vpc:
    VPCId: vpc-0f3f690854f8cfabb
    Subnets: subnet-0a2e229f6b97fa78b,subnet-0f54daeed1aed4c27,subnet-0ef6963481c32f9cc
