option_settings:
  aws:elasticbeanstalk:application:
    # The load balancer polls this path. /health probes RDS, DynamoDB and S3 individually and
    # answers 503 if any is down, so an instance that cannot reach its data stores is taken
    # out of service rather than left serving errors.
    Application Healthcheck URL: /health

  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production

  aws:autoscaling:launchconfiguration:
    # AWS Academy blocks creating our own instance profile, so we use the lab-provided one.
    # This name is fixed by Academy and is the same in every member's sandbox.
    IamInstanceProfile: LabInstanceProfile
    InstanceType: t3.micro

  aws:elasticbeanstalk:environment:
    ServiceRole: LabRole

  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced

  # Runs the X-Ray daemon on the instance, which src/lib/xray.js's traced clients send
  # segments to over UDP at its default address (127.0.0.1:2000) -- the daemon batches and
  # forwards them to the X-Ray service. Needs xray:PutTraceSegments / PutTelemetryRecords on
  # the instance profile; unverified against this lab's actual LabInstanceProfile grants, since
  # no AWS session was available while this was written (see docs/task2-plan.md, Day 1) --
  # confirm segments are actually arriving in the X-Ray console after the first deploy.
  aws:elasticbeanstalk:xray:
    XRayEnabled: true

# Note: there is deliberately no `aws:elasticbeanstalk:container:nodejs` / NodeCommand block.
# That namespace was removed on Amazon Linux 2023 and its presence fails the launch with
# "Unknown or duplicate parameter: NodeCommand". The start command lives in ./Procfile.

# Note: there is deliberately no `aws:ec2:vpc` block and no `SecurityGroups` line above.
#
# AWS Academy issues a brand-new sandbox account on every lab reset, with a brand-new VPC,
# subnets and security groups every time -- there is no such thing as a VPC ID that is valid
# across members or across sessions. A previous version of this file hardcoded one member's
# personal lab IDs, which broke `eb deploy` for everyone else and was already stale by the next
# lab reset regardless of whose IDs they were. That is the same "config is env-driven with zero
# literals" rule the rest of the app follows (see src/config), applied to infrastructure too.
#
# These three values are supplied once, at environment-creation time, as `eb create` flags --
# they stick to the environment after that and `eb deploy` never needs to see them again:
#
#   eb create bridgeability-env \
#     --vpc.id <your-lab-vpc-id> \
#     --vpc.ec2subnets <subnet-a,subnet-b,subnet-c> \
#     --vpc.elbsubnets <subnet-a,subnet-b,subnet-c> \
#     --vpc.securitygroups <your-app-security-group-id> \
#     --vpc.publicip
#
# Find your current lab's IDs with:
#   aws ec2 describe-vpcs --query 'Vpcs[0].VpcId'
#   aws ec2 describe-subnets --filters Name=vpc-id,Values=<vpc-id> --query 'Subnets[].SubnetId'
#   aws ec2 describe-security-groups --filters Name=vpc-id,Values=<vpc-id> --query 'SecurityGroups[].[GroupId,GroupName]'
