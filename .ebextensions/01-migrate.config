# Applies the database schema and seed on every deploy, from inside the VPC.
#
# This is the only place migrations can run: the RDS instance is PubliclyAccessible = false
# and its security group admits 3306 solely from the application security group, so no
# developer machine can reach it. The Beanstalk instance can, because it *is* the
# application tier.
#
# leader_only means that when the environment is load-balanced across two AZs, exactly one
# instance runs the migration rather than all of them racing.
container_commands:
  01_run_migrations:
    command: |
      set -e
      # Amazon Linux 2023 stages the environment properties here. Sourcing them explicitly
      # means the migration sees DB_HOST/DB_USER/... regardless of how the platform chooses
      # to export properties into container commands.
      if [ -f /opt/elasticbeanstalk/deployment/env ]; then
        set -a
        . /opt/elasticbeanstalk/deployment/env
        set +a
      fi
      node db/run-migrations.js
    leader_only: true
