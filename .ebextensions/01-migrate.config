container_commands:
  01_run_migrations:
    command: |
      set -e
      if [ -f /opt/elasticbeanstalk/deployment/env ]; then
        set -a
        . /opt/elasticbeanstalk/deployment/env
        set +a
      fi
      node db/run-migrations.js
    leader_only: true

  02_seed_media:
    command: |
      set -e
      if [ -f /opt/elasticbeanstalk/deployment/env ]; then
        set -a
        . /opt/elasticbeanstalk/deployment/env
        set +a
      fi
      node db/seed-media.js
    leader_only: true
