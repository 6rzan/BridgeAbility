# BridgeAbility environment variables — PLACEHOLDERS ONLY.
#
# Real values live as Elastic Beanstalk environment properties and are never committed.
# Copy this file only to document what must be set; `.env` itself is gitignored.
#
# Note what is NOT here: there is no AWS access key or secret. The application authenticates
# to AWS through the EC2 instance profile (LabInstanceProfile -> LabRole), which supplies
# rotating temporary credentials to the SDK. No long-lived AWS credential exists anywhere in
# this repository.

NODE_ENV=production
PORT=8080

AWS_REGION=us-east-1

# Amazon RDS for MySQL — PubliclyAccessible = false, reachable only from inside the VPC.
DB_HOST=your-instance.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=bridgeability
DB_POOL_LIMIT=10

# Amazon S3 — Block Public Access on; reached only through presigned URLs.
S3_BUCKET=your-bucket-name

# Amazon DynamoDB
DDB_TIMELINE_TABLE=BridgeAbility_BookingTimeline
DDB_SESSIONS_TABLE=BridgeAbility_Sessions

# Session signing key — minimum 32 characters, unique per environment.
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
SESSION_TTL_SECONDS=28800

# Marks the session and CSRF cookies Secure, so the browser sends them over HTTPS only.
# Must stay false until a TLS certificate is attached: a Secure cookie is silently dropped
# over plain HTTP, which would break sign-in entirely. ACM only issues a certificate for a
# domain you can prove you own, and we do not own *.elasticbeanstalk.com, so the lab
# environment has no HTTPS listener. Set true the moment a custom domain is in front.
SESSION_COOKIE_SECURE=false

# Presigned URL lifetimes (seconds) and the upload size cap (bytes).
PRESIGN_GET_TTL_SECONDS=300
PRESIGN_PUT_TTL_SECONDS=300
UPLOAD_MAX_BYTES=5242880
