# Secrets — never commit. scripts/secret-scan.sh enforces this before every push.
.env
.env.*
!.env.example
*.pem
*.key
.aws/
credentials

# Elastic Beanstalk local state (contains environment + account metadata)
.elasticbeanstalk/*
!.elasticbeanstalk/config.yml.example

# Dependencies and build output
node_modules/
npm-debug.log*
dist/
coverage/
.build/

# Submission artefacts (regenerated by scripts/package-submission.js)
submission/
*.zip

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# Local AI/spec tooling — developer scaffolding, not part of the delivered system.
# Excluded so the tracked history stays focused on the application being assessed.
.claude/
.specify/

# Elastic Beanstalk Files
.elasticbeanstalk/*
!.elasticbeanstalk/*.cfg.yml
!.elasticbeanstalk/*.global.yml
