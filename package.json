{
  "name": "bridgeability",
  "version": "1.0.0",
  "description": "Cloud platform for booking and coordinating accessibility services for persons with disabilities",
  "license": "MIT",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node db/run-migrations.js",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "secret-scan": "bash scripts/secret-scan.sh",
    "package": "node scripts/package-submission.js",
    "loadtest": "node scripts/loadtest.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sns": "^3.1131.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "aws-xray-sdk-core": "^3.12.0",
    "aws-xray-sdk-express": "^3.12.0",
    "aws-xray-sdk-mysql": "^3.12.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "mysql2": "^3.11.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "supertest": "^7.0.0"
  }
